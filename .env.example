# Copy to .env (gitignored) — herrscher auto-loads it at startup and floods
# every command + plugin config. Real environment variables override these.
# Override the path with $HERRSCHER_ENV_FILE.

# --- Gateway: discord (required) ---
DISCORD_BOT_TOKEN=
# The Discord user the bot obeys: it reads every channel it can see, but only
# this user's mentions and replies make it act.
DISCORD_USER_ID=
# The server the slash commands are registered in. Optional while the bot is in
# a single server; required once it joins a second one.
# DISCORD_GUILD_ID=
# How much of a turn is posted in-channel: full (default) shows the assistant's
# thinking and each tool's detail, actions drops the thinking, quiet also drops
# the details so no local path or command is ever shown.
# DISCORD_VERBOSITY=full
# DISCORD_CONTEXT_MESSAGES=30
# DISCORD_PLAYBOOK=pr-job

# --- Backend: claude (optional; `claude` must be on PATH) ---
# CLAUDE_CMD=claude
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_STREAM=true

# --- Memory: obsidian (optional; unset = memory disabled) ---
# OBSIDIAN_VAULT=
