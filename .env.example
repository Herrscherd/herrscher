# Copy to .env (gitignored): herrscher auto-loads it at startup and floods
# every command + plugin config. Real environment variables override these.
# Override the path with $HERRSCHER_ENV_FILE.

# --- Gateway: discord (required) ---
DISCORD_BOT_TOKEN=
# The Discord user the bot obeys: it reads every channel it can see, but only
# this user's mentions and replies make it act.
DISCORD_USER_ID=
# How much of a turn is posted in-channel: silent (default) posts the answer and
# nothing else; quiet adds a live list of tool names, with no local path or
# command; actions adds each tool's detail; full also adds the assistant's
# thinking. Raise it only in a channel you would not mind screenshotting.
# DISCORD_VERBOSITY=silent
# DISCORD_CONTEXT_MESSAGES=30
# DISCORD_PLAYBOOK=pr-job

# --- Backend: claude (optional; `claude` must be on PATH) ---
# CLAUDE_CMD=claude
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_STREAM=true

# --- Memory: obsidian (optional; unset = memory disabled) ---
# OBSIDIAN_VAULT=
# Self-authored skills. With MEMORY_LEARNED_SKILLS=true an agent writes down a
# procedure it had to work out with <skill name="...">, the host projects it into
# the session's worktree as a SKILL.md the skills menu already knows how to read,
# and reaching for it is what keeps it alive. A skill revises itself freely in its
# agent's private scope; sharing one with the project's other agents takes an
# explicit `herrscher skill approve`.
# MEMORY_LEARNED_SKILLS=false

# --- Routing: where agent turns run (written by `herrscher init`) ---
# all (default) offers native and gateway models; gateway-only offers gateway
# models only, and then refuses a `session create` carrying a free-form --cmd or
# no --model: both would run the turn on this machine's own vendor login instead
# of the gateway.
# HERRSCHER_ROUTE_POLICY=gateway-only
# Required under gateway-only, and ALWAYS both together: a base URL with no token
# redirects the CLI to the gateway while it keeps authenticating as this
# machine's own account.
# NEUBLOX_GATEWAY_URL=
# NEUBLOX_GATEWAY_TOKEN=
# The model a session takes when it names none. `herrscher models list` shows the
# ids offered under the active policy.
# HERRSCHER_DEFAULT_MODEL=

# --- Remote transport (optional; required only when HERRSCHER_REMOTE names a category) ---
# Shared secret that authenticates the plugin announcements over NATS. Use at least
# 32 random bytes, generated with a cryptographic source, for example
# `openssl rand -base64 48`. Every host and plugin-host that exchanges announcements
# must hold the same value. The host refuses to start a remote category without it.
# The key signs announcements only. It is kept out of the environment the agent's
# vendor CLIs inherit, but processes running as the same user can still read it
# (this file, /proc), so the boundary is the user account.
# Without mTLS (HERRSCHER_TLS_*), remote dials stay on loopback addresses.
# HERRSCHER_ANNOUNCE_KEY=

# --- Terminal TUI ---
# The context window the status bar measures a session's occupancy against, in
# tokens, for every vendor. It overrides the contextLimits table of config.json,
# which sets a size per vendor, and the built-in per-vendor sizes. Set this when a
# model moves under us.
# HERRSCHER_CONTEXT_LIMIT=200000
# The session a launch opens learns: it files what it distils under the project
# it is standing in and under its own agent root, so the window you use all day
# feeds what the next session knows. Set false to restore a session that records
# nothing.
# TERMINAL_LEARN=true
# Registered curation extractor that distils the transcript. An unregistered
# name means nothing is ever recorded, with a warning on `herrscher serve`.
# TERMINAL_EXTRACTOR=llm
# Turns between consolidation passes. 0 leaves consolidation manual/idle-only.
# TERMINAL_CONSOLIDATE_EVERY=10
# Memory root for what the window learns as itself, beside the project root.
# TERMINAL_MEMORY_AGENT=tui
# Force the memory project instead of resolving one from the directory. Naming
# it pins it: the first prompt will not revise it. Folded to a scope segment
# (Mon Projet -> mon-projet) rather than refused.
# TERMINAL_PROJECT=
# When the project is settled. first-turn takes the directory as a guess the
# session's first prompt may revise; launch takes the directory as final.
# TERMINAL_PROJECT_PIN=first-turn
