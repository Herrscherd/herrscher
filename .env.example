# Copy to .env (gitignored) — herrscher auto-loads it at startup and floods
# every command + plugin config. Real environment variables override these.
# Override the path with $HERRSCHER_ENV_FILE.

# --- Gateway: discord (required) ---
DISCORD_BOT_TOKEN=
# The Discord user the bot obeys: it reads every channel it can see, but only
# this user's mentions and replies make it act.
DISCORD_USER_ID=
# How much of a turn is posted in-channel: silent (default) posts the answer and
# nothing else; quiet adds a live list of tool names, with no local path or
# command; actions adds each tool's detail; full also adds the assistant's
# thinking. Raise it only in a channel you would not mind screenshotting.
# DISCORD_VERBOSITY=silent
# DISCORD_CONTEXT_MESSAGES=30
# DISCORD_PLAYBOOK=pr-job

# --- Backend: claude (optional; `claude` must be on PATH) ---
# CLAUDE_CMD=claude
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_STREAM=true

# --- Memory: obsidian (optional; unset = memory disabled) ---
# OBSIDIAN_VAULT=

# --- Routage : où tournent les tours d'agent (écrit par `herrscher init`) ---
# all (défaut) offre les modèles locaux et passerelle ; gateway-only n'offre que
# les modèles passerelle, et refuse alors un `session create` avec un --cmd libre
# ou sans --model : les deux feraient tourner le tour sur le compte de cette
# machine au lieu de la passerelle.
# HERRSCHER_ROUTE_POLICY=gateway-only
# Requis sous gateway-only, et TOUJOURS les deux ensemble : une URL sans jeton
# redirige le CLI vers la passerelle tout en le laissant s'authentifier avec le
# compte de cette machine.
# NEUBLOX_GATEWAY_URL=
# NEUBLOX_GATEWAY_TOKEN=
# Le modèle qu'une session prend quand elle n'en nomme aucun. `herrscher models
# list` donne les ids offerts sous la politique active.
# HERRSCHER_DEFAULT_MODEL=
