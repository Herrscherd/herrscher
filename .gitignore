/herrscher
/herrscher.exe
*.test

# per-session git worktrees created by `herrscher serve`
/.herrscher-sessions/

# local secrets, auto-loaded at startup (see .env.example)
/.env
.superpowers/
.worktrees/

# specs and plans a feature was built from: work notes, not documentation. The
# docs that ship live in Herrscherd/herrscher-docs.
/docs/superpowers/

# local-dev Go workspace (resolves the unmerged gateway branch); never committed
/go.work
/go.work.sum

# atomic-write scratch files (state.json.tmp, transcript .tmp); never committed
*.tmp
.herrscher-scratch/
