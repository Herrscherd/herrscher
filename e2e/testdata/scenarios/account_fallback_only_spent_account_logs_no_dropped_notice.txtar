! exec herrscher serve &daemon&
waitdaemon
exec herrscher session create --name stuck
exec herrscher session seed --name stuck --task 'hello with no quota'
stdout '^echo: hello with no quota$'
kill -INT daemon
wait daemon
! waitdaemon
! stderr 'account notice dropped'
exec cat $VENDORTEST_LOG
stdout '(?m)^prompt .*hello with no quota"$'

-- home/.config/herrscher/config.json --
{"accounts":{"fallback":true}}
-- home/.claude/.credentials.json --
{"claudeAiOauth":{"accessToken":"exhausted-token"}}
