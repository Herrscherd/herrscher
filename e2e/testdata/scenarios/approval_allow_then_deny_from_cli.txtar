! exec herrscher serve &daemon&
waitdaemon
exec herrscher session create --name first --vendor claude --approvals ask
exec herrscher approve rule 'ask Bash(git push*)'
exec herrscher session send --name first --text 'push the branch'
waitapproval APPROVAL
exec herrscher approve allow $APPROVAL
waitlog 'result toolu_\d+ allowed'
exec herrscher session send --name first --text 'push again'
waitapproval APPROVAL
exec herrscher approve deny $APPROVAL --reason 'not today'
waitlog 'result toolu_\d+ denied: herrscher: the operator refused: not today'
! grep 'failed:' $VENDORTEST_LOG
kill -INT daemon
wait daemon
! waitdaemon

-- claude.script --
tool Bash {"command":"git push origin master"}
expect allowed
text pushed the branch
---
tool Bash {"command":"git push origin master"}
expect denied
text push refused
