cp $WORK/plugins.go $WORK/.env.example .
exec herrscher init --yes --no-build --host .
cmp .env .env.example
exec cat plugins.go
stdout 'github.com/Herrscherd/herrscher-claude-backend'
! exec herrscher serve &daemon&
waitdaemon
exec herrscher session create --name cold
exec herrscher session seed --name cold --task 'hello cold install'
stdout '^echo: hello cold install$'
kill -INT daemon
wait daemon
! waitdaemon
exec cat $VENDORTEST_LOG
stdout 'prompt .*hello cold install'
-- .env.example --
CLAUDE_CMD=claude
-- plugins.go --
package main

import (
	// herrscher:plugins
	// herrscher:end
)
