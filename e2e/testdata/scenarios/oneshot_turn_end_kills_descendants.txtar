exec herrscher session create --name oneshot --backend oneshot --cmd 'claude -p' --terminal_only
exec herrscher session seed --name oneshot --task 'say ping please'
grep 'start -p' $WORK/claude.log
! grep 'stream-json' $WORK/claude.log
grep 'say ping please' $WORK/claude.log
descendantgone $WORK/descendant.pid

-- claude.script --
spawn descendant.pid
