! exec herrscher serve &daemon&
waitdaemon
exec herrscher session create --name switching
exec herrscher session seed --name switching --task 'first with claude'
stdout '^from claude$'
exec herrscher session overview
cp stdout $WORK/overview-claude.json
grep -count=1 '"name":"switching"' $WORK/overview-claude.json
grep -count=1 '"name":' $WORK/overview-claude.json
sessionrunning switching claude
exec herrscher session switch --name switching --vendor codex --cmd codex
sessionstopped switching claude
exec herrscher session overview
cp stdout $WORK/overview-codex.json
grep -count=1 '"name":"switching"' $WORK/overview-codex.json
grep -count=1 '"vendor":"codex"' $WORK/overview-codex.json
grep -count=1 '"name":' $WORK/overview-codex.json
exec herrscher session seed --name switching --task 'second with codex'
stdout '^echo: second with codex$'
exec cat $VENDORTEST_LOG
stdout 'codex prompt .*second with codex'
sessionrunning switching codex
exec herrscher session switch --name switching --vendor cursor --cmd cursor-agent
sessionstopped switching codex
exec herrscher session overview
cp stdout $WORK/overview-cursor.json
grep -count=1 '"name":"switching"' $WORK/overview-cursor.json
grep -count=1 '"vendor":"cursor"' $WORK/overview-cursor.json
grep -count=1 '"name":' $WORK/overview-cursor.json
exec herrscher session seed --name switching --task 'third with cursor'
stdout '^echo: third with cursor$'
exec cat $VENDORTEST_LOG
stdout 'cursor prompt .*third with cursor'
exec herrscher session switch --name switching --vendor grok --cmd grok
exec herrscher session overview
cp stdout $WORK/overview-grok.json
grep -count=1 '"vendor":"grok"' $WORK/overview-grok.json
exec herrscher session seed --name switching --task 'fourth with grok'
stdout '^echo: fourth with grok$'
exec cat $VENDORTEST_LOG
stdout 'grok prompt .*fourth with grok'
exec herrscher session switch --name switching --vendor antigravity --cmd agy
exec herrscher session overview
cp stdout $WORK/overview-antigravity.json
grep -count=1 '"vendor":"antigravity"' $WORK/overview-antigravity.json
exec herrscher session seed --name switching --task 'fifth with antigravity'
stdout '^echo: fifth with antigravity$'
exec cat $VENDORTEST_LOG
stdout 'antigravity prompt .*fifth with antigravity'
kill -INT daemon
wait daemon
! waitdaemon

-- claude.script --
text from claude
